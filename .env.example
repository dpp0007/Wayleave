# Required. TinyFish key (Research must be enabled on the account). https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Required for the Gemini double-check. Also accepted under the name Gemni_API. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# Preferred Gemini model. If it is unavailable the app falls back to gemini-3.1-flash-lite, then gemini-3.5-flash.
GEMINI_MODEL=
# Minutes to wait for deep research before using its partial result or the quick-read fallback (default 8).
RESEARCH_DEADLINE_MIN=8
