# Required. TinyFish key (Research must be enabled on the account). https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Required for the Gemini double-check and gap filling. Also accepted under the name Gemni_API. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended for any public deployment: a shared passcode that unlocks the paid routes (research spends real credits).
ACCESS_CODE=

# Optional
# Preferred Gemini model. If it is unavailable the app falls back to gemini-3.1-flash-lite, then gemini-3.5-flash.
GEMINI_MODEL=
# Minutes to wait for deep research before using its partial result or the quick-read fallback (default 8).
RESEARCH_DEADLINE_MIN=8
# Daily budget of deep-research runs, one per place (default 60). Best effort per server instance.
MAX_RUNS_PER_DAY=60
# Public origin for the sitemap and metadata (on Vercel the production domain is detected automatically).
NEXT_PUBLIC_SITE_URL=
